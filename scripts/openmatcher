#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path

import pandas as pd

from openmatcher_matching import MatchingConfig
from openmatcher_matching.engines import EngineRunRequest, engine_from_name


def main() -> None:
    parser = argparse.ArgumentParser(prog="openmatcher")
    subparsers = parser.add_subparsers(dest="command", required=True)
    run = subparsers.add_parser("run")
    run.add_argument("--input", required=True)
    run.add_argument("--name-column", default="name")
    run.add_argument("--threshold", type=float, default=0.86)
    run.add_argument("--engine", choices=["local", "spark"], default="local")
    run.add_argument("--output", default="openmatcher_results.json")
    args = parser.parse_args()

    if args.command == "run":
        path = Path(args.input)
        if path.suffix == ".parquet":
            frame = pd.read_parquet(path)
        elif path.suffix == ".json":
            frame = pd.read_json(path)
        else:
            try:
                frame = pd.read_csv(path)
            except UnicodeDecodeError:
                frame = pd.read_csv(path, encoding="latin1")
        engine = engine_from_name(args.engine)
        result = engine.run(
            EngineRunRequest(
                records=frame.fillna("").to_dict(orient="records"),
                config=MatchingConfig(name_column=args.name_column, threshold=args.threshold),
            )
        )
        Path(args.output).write_text(json.dumps(result, indent=2, default=str), encoding="utf-8")
        print(f"Wrote {args.output}")


if __name__ == "__main__":
    main()

